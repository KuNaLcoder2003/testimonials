generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Space {
  id String @id @default(uuid())
  space_name String @db.VarChar(255)
  header String
  message String
  question_1 String
  question_2 String
  question_3 String
  question_4 String
  question_5 String
  testimonials Testimonial[]
}

model Testimonial {
  id String @id @default(uuid())
  space_id String
  type String
  avatar String
  email String
  name String
  space Space @relation(fields: [space_id] , references: [id])
}